# Development secrets for the local compose stack ONLY. They match the generated Keycloak
# realm (profiles/<profile>/data/keycloak/realm.json). Never reuse them anywhere else.
PROFILE=acme
OIDC_CLIENT_SECRET=dev-bot-secret
KEYCLOAK_CONSOLE_SECRET=dev-console-secret
KEYCLOAK_GATEWAY_SECRET=dev-gateway-secret
STS_BOT_SECRET=dev-sts-bot-secret
STS_CONSOLE_SECRET=dev-sts-console-secret
STS_A2A_PROXY_SECRET=dev-sts-a2a-secret
GATEWAY_STS_SECRET=dev-sts-gateway-secret
WARDEN_ADMIN_TOKEN=dev-admin-token
APPROVAL_WEBHOOK_SECRET=dev-webhook-secret
AUDIT_HMAC_KEY=dev-audit-hmac
RUST_LOG=info,rig=warn
# Optional: a real model instead of the scripted one.
# OPENROUTER_API_KEY=
